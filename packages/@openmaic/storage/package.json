{
  "name": "@openmaic/storage",
  "version": "0.29.1",
  "description": "The MAIC pluggable persistence layer: document / runtime / KV / asset primitives with browser and HTTP backends, depending only on @openmaic/dsl.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime/http": {
      "types": "./dist/runtime/http.d.ts",
      "import": "./dist/runtime/http.js",
      "require": "./dist/runtime/http.js",
      "default": "./dist/runtime/http.js"
    },
    "./document/http": {
      "types": "./dist/document/http.d.ts",
      "import": "./dist/document/http.js",
      "require": "./dist/document/http.js",
      "default": "./dist/document/http.js"
    },
    "./kv/http": {
      "types": "./dist/kv/http.d.ts",
      "import": "./dist/kv/http.js",
      "require": "./dist/kv/http.js",
      "default": "./dist/kv/http.js"
    },
    "./asset/http": {
      "types": "./dist/asset/http.d.ts",
      "import": "./dist/asset/http.js",
      "require": "./dist/asset/http.js",
      "default": "./dist/asset/http.js"
    },
    "./document/pg": {
      "types": "./dist/document/pg.d.ts",
      "import": "./dist/document/pg.js",
      "require": "./dist/document/pg.js",
      "default": "./dist/document/pg.js"
    },
    "./runtime/pg": {
      "types": "./dist/runtime/pg.d.ts",
      "import": "./dist/runtime/pg.js",
      "require": "./dist/runtime/pg.js",
      "default": "./dist/runtime/pg.js"
    },
    "./agent-session/pg": {
      "types": "./dist/agent-session/pg.d.ts",
      "import": "./dist/agent-session/pg.js",
      "require": "./dist/agent-session/pg.js",
      "default": "./dist/agent-session/pg.js"
    },
    "./skill/pg": {
      "types": "./dist/skill/pg.d.ts",
      "import": "./dist/skill/pg.js",
      "require": "./dist/skill/pg.js",
      "default": "./dist/skill/pg.js"
    },
    "./material/pg": {
      "types": "./dist/material/pg.d.ts",
      "import": "./dist/material/pg.js",
      "require": "./dist/material/pg.js",
      "default": "./dist/material/pg.js"
    },
    "./asset/pg": {
      "types": "./dist/asset/pg.d.ts",
      "import": "./dist/asset/pg.js",
      "require": "./dist/asset/pg.js",
      "default": "./dist/asset/pg.js"
    },
    "./asset/pg-bytes": {
      "types": "./dist/asset/pg-bytes.d.ts",
      "import": "./dist/asset/pg-bytes.js",
      "require": "./dist/asset/pg-bytes.js",
      "default": "./dist/asset/pg-bytes.js"
    },
    "./asset/s3-bytes": {
      "types": "./dist/asset/s3-bytes.d.ts",
      "import": "./dist/asset/s3-bytes.js",
      "require": "./dist/asset/s3-bytes.js",
      "default": "./dist/asset/s3-bytes.js"
    },
    "./asset/collector": {
      "types": "./dist/asset/collector.d.ts",
      "import": "./dist/asset/collector.js",
      "require": "./dist/asset/collector.js",
      "default": "./dist/asset/collector.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/reference": {
      "types": "./dist/server/reference.d.ts",
      "import": "./dist/server/reference.js",
      "require": "./dist/server/reference.js",
      "default": "./dist/server/reference.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "maic",
    "storage",
    "persistence",
    "kv",
    "indexeddb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasoal-org/kafuo-teaching-engine",
    "directory": "packages/@openmaic/storage"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@openmaic/dsl": "workspace:^"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@electric-sql/pglite": "^0.3.14",
    "@types/pg": "^8.15.5",
    "fake-indexeddb": "^6.0.0",
    "pg": "^8.16.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
