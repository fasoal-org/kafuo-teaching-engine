{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/testing/test_guard.py\" --claude || exit 2",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/testing/test_guard.py\" --authorize-claude || exit 2",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
